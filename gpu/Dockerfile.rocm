# Override ROCM_IMAGE with a tag supported by the target ROCm host/device.
ARG ROCM_IMAGE=rocm/dev-ubuntu-22.04
FROM ${ROCM_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 MODEL_DIR=/models
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates tini && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/gql
COPY gpu/requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt
COPY gpu/runtime ./runtime
COPY gpu/schema ./schema
RUN useradd --system --create-home gql && mkdir -p /models /cache && chown -R gql:gql /opt/gql /models /cache
USER gql
EXPOSE 8080
VOLUME ["/models", "/cache"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python3", "-m", "uvicorn", "runtime.app:app", "--host", "0.0.0.0", "--port", "8080"]
