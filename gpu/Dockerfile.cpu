FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 MODEL_DIR=/models HF_HOME=/cache/huggingface
RUN apt-get update && apt-get install -y --no-install-recommends tini ca-certificates && rm -rf /var/lib/apt/lists/* && useradd --system --create-home gql
WORKDIR /opt/gql
COPY gpu/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt
COPY gpu/runtime ./runtime
COPY gpu/schema ./schema
RUN mkdir -p /models /cache && chown -R gql:gql /opt/gql /models /cache
USER gql
EXPOSE 8080
VOLUME ["/models", "/cache"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "uvicorn", "runtime.app:app", "--host", "0.0.0.0", "--port", "8080"]
